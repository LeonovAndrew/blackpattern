Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
	Options +FollowSymLinks
	RewriteEngine On

	# Canonical public URL: HTTPS without www.
	# Keep the local Open Server host "blackpattern" unaffected.
	RewriteCond %{HTTP_HOST} ^www\.blackpattern\.ru(?::\d+)?$ [NC]
	RewriteRule ^ https://blackpattern.ru%{REQUEST_URI} [R=301,L,NE]

	# nginx may terminate TLS before forwarding the request to Apache.
	RewriteCond %{HTTP_HOST} ^blackpattern\.ru(?::\d+)?$ [NC]
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
	RewriteRule ^ https://blackpattern.ru%{REQUEST_URI} [R=301,L,NE]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-l
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !/bitrix/urlrewrite.php$
	RewriteRule ^(.*)$ /bitrix/urlrewrite.php [L]
	RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_dir.c>
	DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_negotiation.c>
	Options -MultiViews
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresByType image/jpeg "access plus 3 day"
	ExpiresByType image/gif "access plus 3 day"
	ExpiresByType image/png "access plus 3 day"
	ExpiresByType text/css "access plus 3 day"
	ExpiresByType application/javascript "access plus 3 day"
</IfModule>
